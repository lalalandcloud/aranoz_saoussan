<!-- lien likes: -->
                {auth?.user && (
                    <div>
                        <Link href="/public/user/pins"> Mes favoris</Link>
                    </div>
                )}

<!-- catégories produits: -->
                <ul>
                    {categories?.map((category) => (
                        <li key={category.id}>
                            {category.name}
                        </li>
                    ))}
                </ul>

<!-- listes produits: -->

                {products?.length === 0 ? (
                    <p>Aucun produit disponible</p>
                ) : (
                    <div>
                        {products?.map((product) => (
                            <div key={product.id}>
                                <h3>{product.name}</h3>
                                
                                <img 
                                    src={`/storage/${product.img_main}`} 
                                    alt={product.name}
                                />
                                
                                <PinButton product={product} />
                                

                                <p>Prix: {product.price}€</p>
                                <p>Stock: {product.stock}</p>
                                <p>Catégorie: {product.category?.name}</p>
                                
                                <AddToCart product={product} />
                                
                                {product.pin && <p>⭐ Épinglé par l'admin</p>}
                                
                                <p>{product.description}</p>
                                
                                <Link href={`/products/${product.id}`}>Voir détails</Link>
                                
                                <hr />
                            </div>
                        ))}
                    </div>
                )}
